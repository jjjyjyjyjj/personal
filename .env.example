# Copy to .env.local for local use, and add the same three in
# Vercel → Project → Settings → Environment Variables for the live site.
# Real values go only in those two places — never in this file.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret keys (starts "sb_secret_").
# Server only; never expose it in the browser.
SUPABASE_SECRET_KEY=

# Password for the approval page at /admin. Use a long, unique one.
ADMIN_PASSWORD=
